# iCloud 照片同步 配置样例
# 用法：复制本文件为 config.ini，按需修改后保存。
# 注意：config.ini 已被 .gitignore 忽略，不会提交到仓库（避免泄露你的路径/账号）。

[settings]
# 照片备份根目录；每个账号会在其下建独立子文件夹
backup_root = ~/iCloudPhotos
# 登录凭证目录，请勿手动删改
# 安全提醒：该目录等同于你 iCloud 照片库的完整访问凭据，
# 必须放在本机非同步目录，不要放进仓库、网盘（OneDrive/Dropbox/iCloud Drive）同步目录
cookie_dir = ~/.icloud_session
# icloudpd 可执行文件路径；若已在 PATH 中可直接写 icloudpd
tool = icloudpd
# iCloud 区域：中国大陆填 cn；其他地区留空
domain = cn
# 是否启用“手机删、电脑跟着删”（镜像删除，破坏性，默认关闭）。
# 开启后：iCloud 上已删除的照片，本机也会同步删除；这些删除属于预期镜像行为，
# 不再写“需关注”标记、也不询问。需要 icloudpd >= 1.12.0 才支持。
auto_delete = false

# 账号小节示例（复制并改成你自己的）：
# [account_example]
# apple_id = your-apple-id@example.com
# folder = example          # 子文件夹名；留空则直接放备份根目录

# ---- 失败通知邮件（可选，默认关闭）----
# 同步失败时（含磁盘空间过低）自动发邮件提醒你。需自行准备 SMTP 账号。
# QQ 邮箱 SMTP：smtp.qq.com，端口 465（SSL）或 587（STARTTLS）；
# 密码不是 QQ 登录密码，而是“授权码”（QQ邮箱网页版 -> 设置 -> 账户 -> 开启IMAP/SMTP -> 生成授权码）。
# [notify]
# enabled = false
# smtp_host = smtp.qq.com
# smtp_port = 465
# smtp_security = ssl        # ssl 或 starttls
# smtp_user = your-qq@qq.com
# smtp_pass = 你的授权码
# from = your-qq@qq.com
# to = your-qq@qq.com

# ---- 日志自动轮转（可选）----
# sync.log 超过 max_size_mb（MB）就备份为 .1/.2/...，最多保留 keep 份。
# [log]
# max_size_mb = 5
# keep = 5

# ---- 磁盘空间预警（可选）----
# 备份盘剩余低于 warn_free_gb（GB）时，在日志（及通知邮件）里提醒。
# [disk]
# warn_free_gb = 5
